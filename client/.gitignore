# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# From the repository root
cat > .gitignore <<'EOF'
# Node.js
node_modules/
npm-debug.log*
*.log
npm-debug.log*
.env
.env.local
.env.*.local

# Vite / React
client/dist/
client/node_modules/
client/.env*
client/.env.*.local

# Server
./server/node_modules/
./server/*.log
./server/.env*
./server/.env.*.local

# OS‑specific files
.DS_Store
Thumbs.db
EOF